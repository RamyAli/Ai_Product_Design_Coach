{
  "name": "product-design-coach",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first AI mentor for practicing end-to-end product design projects.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run db:migrate && next dev -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "npm run db:migrate && next start -H 127.0.0.1",
    "setup": "prisma generate && npm run db:migrate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "tsx scripts/db-studio.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
