# Copy to .env and adjust. Never commit real secrets.

# Where the SQLite database, uploaded files, backups and the local secrets file live.
# Defaults to ~/.product-design-coach when unset. Use an absolute path.
# APP_DATA_DIR=/absolute/path/to/product-design-coach-data

# AI provider: "anthropic" or "mock". When unset, the Settings page decides
# (and the app falls back to the clearly labelled offline mock provider if no key is configured).
# AI_PROVIDER=anthropic

# Anthropic API key. Takes precedence over a key saved from the Settings page.
# ANTHROPIC_API_KEY=

# Model used for generation and reviews (default: claude-opus-5-5).
# AI_MODEL=claude-opus-5-5

# Optional: Figma personal access token (read-only file scope) so the app can read
# file/frame names for submitted Figma links. Without it, links are stored but not opened.
# FIGMA_ACCESS_TOKEN=
